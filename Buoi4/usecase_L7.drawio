        <mxCell id="lgBox" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="20" y="880" width="760" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="lgTitle" value="&lt;b&gt;CHÚ THÍCH – Ý nghĩa các hình trong sơ đồ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="888" width="500" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="lgActor" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="925" width="26" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lgActorT" value="&lt;b&gt;Hình người que = ACTOR (tác nhân)&lt;/b&gt;&lt;br&gt;Người (hoặc hệ thống) nằm NGOÀI hệ thống và trực tiếp dùng hệ thống để đạt mục tiêu. Ở đây: Nhân viên Marketing, Quản lý cửa hàng." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="920" width="270" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="lgActor2" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="1015" width="26" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lgActor2T" value="&lt;b&gt;Hình người que nét đứt = ACTOR là hệ thống ngoài&lt;/b&gt;&lt;br&gt;Hệ thống/tệp bên ngoài cung cấp dữ liệu cho use case. Ở đây: Tệp nguồn Excel/CSV." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="1010" width="270" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="lgOval" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="1105" width="60" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="lgOvalT" value="&lt;b&gt;Hình oval (elip) = USE CASE&lt;/b&gt;&lt;br&gt;Một mục tiêu hoàn chỉnh actor đạt được; tên = Động từ + đối tượng. Oval CAM = use case cốt lõi (UC5, có đặc tả chi tiết); oval XANH = các use case còn lại." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="1095" width="270" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="lgOval2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="1180" width="60" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="lgOval2T" value="&lt;i&gt;(oval cam: use case quan trọng nhất)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="110" y="1185" width="270" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="lgLine" value="" style="endArrow=none;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="940" as="sourcePoint"/>
            <mxPoint x="490" y="940" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lgLineT" value="&lt;b&gt;Đường nét liền = ASSOCIATION&lt;/b&gt;&lt;br&gt;Actor có tham gia use case ở đầu kia của đường nối." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="925" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lgInc" value="" style="endArrow=open;endSize=10;dashed=1;html=1;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="410" y="1035" as="sourcePoint"/>
            <mxPoint x="490" y="1035" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="lgIncT" value="&lt;b&gt;Mũi tên nét đứt «include» = BAO GỒM&lt;/b&gt;&lt;br&gt;Use case gốc LUÔN gọi use case được trỏ tới như một bước bắt buộc. Mũi tên trỏ về use case được gọi. Ví dụ: UC1 bao gồm UC2 và UC7; UC5 bao gồm UC4." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="1010" width="260" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="lgBnd" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="1130" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="lgBndT" value="&lt;b&gt;Hình chữ nhật lớn = RANH GIỚI HỆ THỐNG&lt;/b&gt;&lt;br&gt;Phạm vi hệ thống đang xây dựng. Chỉ chứa use case; mọi actor nằm bên ngoài." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="1115" width="260" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lgNote" value="&lt;i&gt;Lưu ý: UC2 và UC7 do UC1 tự gọi nên không có actor riêng, thể hiện bằng «include». Sơ đồ không dùng «extend». Thuật ngữ &quot;cặp nghi trùng&quot;, &quot;chỉ số mức độ sạch&quot; thống nhất với SRS mục 1.3.&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="190" y="1200" width="580" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
